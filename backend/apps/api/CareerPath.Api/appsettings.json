{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/careerpath-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 31,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Jwt": {
    "Key": "careerpath-bharat-secure-production-jwt-token-signing-key-2026",
    "Issuer": "CareerPathBharat",
    "Audience": "CareerPathBharatClients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "https://proud-smoke-0f63d4700.7.azurestaticapps.net",
      "https://witty-ocean-0f9463200.7.azurestaticapps.net",
      "https://careerpath-bharat.azurestaticapps.net",
      "http://localhost:3000"
    ]
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-1.5-flash"
  },
  "AllowedHosts": "*"
}
